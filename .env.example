# Copy this file to .env and fill in your values.
#
# Note: any value below may instead be the *name* of another environment
# variable already set in your shell/host (e.g. a secret injected by your
# deployment platform). If a variable with that name exists, its value is
# used; otherwise the literal value written here is used as-is.
# Example: REDIS_DB_PASSWORD=REDIS_PASSWORD looks up REDIS_PASSWORD first
# and falls back to the literal string "REDIS_PASSWORD" if it isn't set.

# ---- Self-managed Redis database ----
# Used by RedisVL for the semantic cache and semantic router (utils.py).
REDIS_DB_HOST=localhost
REDIS_DB_PORT=6379
REDIS_DB_USER=default
REDIS_DB_PASSWORD=


# Path to the semantic router's route definitions, relative to the app
# directory (or absolute). Not subject to the environment-variable
# indirection described above - read as a literal file path.
LLM_ROUTER_FILE=semantic-routes.json

# ---- Redis Iris Auth Key ----
IRIS_API_KEY=

# ---- Redis Iris Agent Playbooks ----
AGENT_PLAYBOOKS_URL=
AGENT_PLAYBOOKS_PLAYBOOK_ID=
FAQ_SEMANTIC_THRESHOLD=0.75
KNOWLEDGE_BASE_FILE=knowledge-base.json
SUBJECT_ID=finance


# ---- Redis Iris Agent Memory ----
AGENT_MEMORY_URL=https://your-agent-memory-endpoint
AGENT_MEMORY_STORE_ID=your-store-id

# ---- Redis Iris Context Gateway (context surface) ----
CONTEXT_GATEWAY_URL=
CONTEXT_UID_PATTERN=ACC[0-9]{6}

# ---- LLM ----
OPENAI_API_KEY=your-openai-api-key
LLM_PROMPT=llm_prompt
CONTEXT_GATEWAY_MODEL=gpt-4o-mini
LLM_TOOL_SELECTOR_PROMPT=llm-prompt-tool-selector
ENABLE_SEMANTIC_CACHE=false

# Welcome flow: the greeting is sent when a chat starts and asks for the UID (account number). The next two are sent
# once the user replies with it: the first when memories exist for that UID ({memories} lists them), the second when
# none do ({account_num} is available). Empty WELCOME_MESSAGE_FILE turns the welcome flow off.
WELCOME_MESSAGE_FILE=welcome-message
WELCOME_BACK_MESSAGE_FILE=welcome-back-message
WELCOME_BACK_PROMPT_FILE=welcome-back-prompt
WELCOME_NEW_MESSAGE_FILE=welcome-new-message
# Which long-term memories the welcome-back message lists: only this memory_type (semantic = lasting facts and
# preferences, episodic = events). Empty lists every type.
WELCOME_MEMORY_TYPE=semantic

# Log level of the application: DEBUG, INFO, WARNING, ERROR or CRITICAL (most severe, the default).
LOG_LEVEL=CRITICAL
